<div
  class="vibeproof-root vibeproof-feed"
  data-vibeproof-mode="feed"
  data-vibeproof-product-id="gid://shopify/Product/{{ product.id }}"
  data-vibeproof-product-handle="{{ product.handle | escape }}"
  data-vibeproof-product-title="{{ product.title | escape }}"
  data-vibeproof-limit="{{ block.settings.max_reviews }}"
  data-vibeproof-heading="{{ block.settings.heading | escape }}"
  data-vibeproof-filters="{{ block.settings.show_filters }}"
  {{ block.shopify_attributes }}
>
  <span class="vibeproof-loading">Loading reviews…</span>
</div>

{% schema %}
{
  "name": "Review feed",
  "target": "section",
  "stylesheet": "vibeproof.css",
  "javascript": "vibeproof-feed.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "range",
      "id": "max_reviews",
      "label": "Reviews to show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show rating filters",
      "default": true
    }
  ]
}
{% endschema %}

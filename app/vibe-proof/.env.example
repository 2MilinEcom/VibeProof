# Shopify app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_products,read_orders,write_app_proxy

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vibeproof?sslmode=require

# Internal signing / hashing
VIBEPROOF_HASH_SECRET=
CRON_SECRET=

# Customer photo/video storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Post-purchase review email (Resend)
RESEND_API_KEY=
REVIEW_EMAIL_FROM=Reviews <reviews@example.com>

# Optional OpenAI-compatible AI provider
AI_API_URL=
AI_API_KEY=
AI_MODEL=
